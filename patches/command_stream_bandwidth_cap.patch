@@ -74,7 +74,43 @@
   rand int   hi_count[];      // prefix-sum helper for requirement 3
   rand int   dma_running[];   // prefix-sum helper for requirement 5
 
-  // write constraints here
+  constraint c_size {
+    cmd_list.size() inside {[15 : 20]};
+    hi_count.size() == cmd_list.size();
+    dma_running.size() == cmd_list.size();
+  }
+
+  constraint c_type {
+    foreach (cmd_list[i]) cmd_list[i].cmd_type inside {READ, WRITE, FLUSH};
+  }
+
+  constraint c_dist {
+    foreach (cmd_list[i]) {
+      if (cmd_list[i].prio == PRIO_LOW) {
+        cmd_list[i].cmd_type dist {READ := 3, WRITE := 3, FLUSH := 1};
+      }
+    }
+  }
+
+  constraint c_hi_prefix {
+    foreach (cmd_list[i]) {
+      if (i == 0) hi_count[i] == (cmd_list[i].prio == PRIO_HIGH ? 1 : 0);
+      else hi_count[i] == hi_count[i-1] + (cmd_list[i].prio == PRIO_HIGH ? 1 : 0);
+    }
+  }
+  constraint c_hi_quota { hi_count[cmd_list.size()-1] == 3; }
+
+  constraint c_dma_prefix {
+    foreach (cmd_list[i]) {
+      if (i == 0) {
+        dma_running[i] == (cmd_list[i].cmd_type == WRITE ? int'(cmd_list[i].dma_size) : 0);
+      } else {
+        dma_running[i] == dma_running[i-1]
+                           + (cmd_list[i].cmd_type == WRITE ? int'(cmd_list[i].dma_size) : 0);
+      }
+    }
+  }
+  constraint c_bandwidth { dma_running[cmd_list.size()-1] <= 4096; }
 endclass
 
